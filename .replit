run = "PORT=5000 python run.py serve"
entrypoint = "run.py"
modules = ["python-3.12", "web", "nodejs-22"]

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "python -m pip install -r backend/requirements.lock"]
run = ["sh", "-c", "python run.py serve"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python run.py serve"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
